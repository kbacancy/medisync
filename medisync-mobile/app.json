{
  "expo": {
    "name": "MediSync",
    "slug": "medisync-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D6B5E"
    },
    "ios": {
      "bundleIdentifier": "com.medisync.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medisync.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D6B5E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D6B5E",
          "androidMode": "default",
          "androidCollapsedTitle": "MediSync",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MediSync to access your camera for video consultations",
          "microphonePermission": "Allow MediSync to access your microphone for video consultations"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow MediSync to detect smart bottle cap movements"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "scheme": "medisync",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b6ca721-a94a-4fc5-b283-6728fb6ffd59"
      }
    },
    "owner": "ketanmistry"
  }
}
